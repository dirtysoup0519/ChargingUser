QWidget {
    background: #FFFFFF;
    color: #202B3C;
    font-family: "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
    font-size: 12px;
}
QWidget#pageBackground { background: #F6F8FC; }
QWidget#topBar, QWidget#headerBar, QFrame#bottomBar {
    background: #FFFFFF;
    border-color: #E9EDF2;
}
QWidget#topBar, QWidget#headerBar { border-bottom: 1px solid #E9EDF2; }
QFrame#bottomBar { border-top: 1px solid #E9EDF2; }
QLabel#brandLabel { color: #1677FF; font-size: 28px; font-weight: 800; }
QLabel#sloganLabel, QLabel#hintLabel, QLabel.subtle { color: #8994A3; font-size: 11px; }
QLabel#pageTitle, QLabel#sectionTitle, QLabel#chargingPageTitle, QLabel#profilePageTitle {
    color: #202B3C; font-size: 17px; font-weight: 700;
}
QPushButton#backButton {
    background: transparent; border: none; color: #334155;
    font-size: 32px; font-weight: 400; padding: 0;
}
QPushButton#backButton:hover { background: #F1F5F9; border-radius: 22px; }
QLabel#avatarLabel {
    background: #DDEBFF; color: #5D7FAF; border: 4px solid #EDF4FF;
    border-radius: 56px; font-size: 18px; font-weight: 700;
}
QPushButton#avatarButton {
    background: transparent; border: none; color: #1677FF;
    font-size: 13px; font-weight: 600; padding: 3px 12px;
}
QPushButton#avatarButton:disabled { color: #1677FF; }
QLabel#nicknameLabel, QLabel#phoneLabel {
    color: #202B3C; font-size: 13px; font-weight: 700;
}
QLineEdit {
    background: #F8FAFC; border: 1px solid #E5EAF0;
    border-radius: 10px; padding: 0 13px; font-size: 13px;
}
QLineEdit:focus { background: #FFFFFF; border-color: #7EB2FF; }
QLineEdit:read-only { color: #98A2B1; background: #F3F5F8; }
QPushButton#primaryButton, QPushButton#btnLogin, QPushButton#saveButton,
QPushButton#chargeButton, QPushButton#startButton {
    background: #1677FF; color: #FFFFFF; border: none;
    border-radius: 11px; font-size: 14px; font-weight: 700;
}
QPushButton#primaryButton:hover, QPushButton#btnLogin:hover,
QPushButton#saveButton:hover, QPushButton#chargeButton:hover,
QPushButton#startButton:hover { background: #096BEE; }
QPushButton#btnLogin:disabled, QPushButton#saveButton:disabled {
    background: #A9C9F8; color: #F7FAFF;
}
QLabel#loadingIndicator { color: #1677FF; font-size: 11px; }
QLabel#errorLabel[feedbackKind="neutral"] { color: #687386; }
QLabel#errorLabel[feedbackKind="success"] { color: #13966B; }
QLabel#errorLabel[feedbackKind="error"] { color: #D14343; }
QCheckBox#agreementCheck[validationError="true"] { color: #D14343; }
QLabel#errorLabel[feedbackKind="unknown"] {
    color: #9A6700; background: #FFF7D6;
    border: 1px solid #F1D179; border-radius: 8px; padding: 7px;
}
QPushButton#secondaryButton, QPushButton#navigationButton {
    background: #EAF3FF; color: #1677FF; border: none;
    border-radius: 11px; font-size: 13px; font-weight: 700;
}
QPushButton#btnStationSearch {
    background: #1677FF; color: #FFFFFF; border: none;
    border-radius: 9px; font-weight: 700;
}
QPushButton#btnLocateMap {
    background: #FFFFFF; color: #1677FF; border: 1px solid #D5E4FA;
    border-radius: 21px; padding: 7px;
}
QPushButton#btnLocateMap:hover { background: #F2F7FF; border-color: #9FC4FF; }
QPushButton#btnLocateMap:pressed { background: #E7F1FF; border-color: #1677FF; }
QPushButton#btnSearchArea {
    background: #FFFFFF; color: #1677FF; border: 1px solid #D5E4FA;
    border-radius: 19px; font-size: 12px; font-weight: 700;
}
QLabel#searchErrorLabel {
    color: #D14343; background: #FFF4F4; border-bottom: 1px solid #F2CACA;
    padding: 6px 12px;
}
QPushButton#searchRetryButton {
    background: #FFF4F4; color: #1677FF; border: none;
    border-bottom: 1px solid #F2CACA; font-weight: 700;
}
QFrame.card, QFrame#profileCard, QFrame#walletCard, QFrame#summaryCard,
QFrame#feeCard, QFrame#chargingEmptyCard {
    background: #FFFFFF; border: 1px solid #E7ECF2; border-radius: 13px;
}
QWidget#chargingPage, QWidget#profilePage, QWidget#walletRechargePage { background: #F6F8FC; }
QFrame#rechargeBalanceCard {
    background: #18B8AD; border: none; border-radius: 14px;
}
QFrame#rechargeBalanceCard QLabel, QWidget#balanceTextBlock { background: transparent; color: #FFFFFF; }
QLabel#balanceTitleLabel { font-size: 14px; font-weight: 600; }
QLabel#balanceValueLabel { font-size: 30px; font-weight: 700; }
QLabel#amountTitleLabel, QLabel#customAmountTitleLabel {
    color: #202B3C; font-size: 16px; font-weight: 700;
}
QPushButton#amount20Button, QPushButton#amount50Button,
QPushButton#amount100Button, QPushButton#amount200Button {
    background: #FFFFFF; color: #4E596A; border: 1px solid #DCE3EC;
    border-radius: 11px; font-size: 14px; font-weight: 600;
}
QPushButton#amount20Button:checked, QPushButton#amount50Button:checked,
QPushButton#amount100Button:checked, QPushButton#amount200Button:checked {
    color: #1677FF; border: 2px solid #1677FF; background: #F7FAFF;
}
QFrame#securityHintCard {
    background: #F1F7FF; border: 1px solid #BCD8FF;
    border-radius: 11px;
}
QLabel#securityHintLabel {
    color: #687386; background: #F1F7FF; border: 1px solid #BCD8FF;
    border: none; font-size: 12px;
}
QPushButton#confirmRechargeButton {
    background: #1677FF; color: #FFFFFF; border: none;
    border-radius: 11px; font-size: 15px; font-weight: 700;
}
QPushButton#confirmRechargeButton:hover { background: #096BEE; }
QLabel#chargingEmptyTitle { font-size: 14px; font-weight: 700; }
QLabel#chargingEmptyHint { color: #8994A3; font-size: 11px; }
QLabel#profileAvatarLabel {
    background: #DDEBFF; color: #5D7FAF; border: 4px solid #EDF4FF;
    border-radius: 43px; font-size: 14px; font-weight: 700;
}
QLabel#profileSummaryLabel { color: #202B3C; font-size: 17px; font-weight: 700; }
QLabel#profilePhoneLabel { color: #687386; font-size: 13px; }
QLabel#walletTitleLabel { color: #E8FFFC; font-size: 12px; }
QLabel#walletSummaryLabel { color: #FFFFFF; font-size: 25px; font-weight: 600; }
QToolButton#btnEditProfile {
    background: transparent; color: #687386; border: none;
    padding: 7px 2px; font-size: 12px;
}
QToolButton#btnEditProfile:hover { color: #1677FF; }
QFrame#walletCard { background: #18B8AD; border: none; border-radius: 14px; }
QFrame#walletCard QLabel, QWidget#walletTextBlock { background: transparent; }
QPushButton#btnRecharge {
    background: #FFFFFF; color: #12AFA5; border: none;
    border-radius: 22px; padding: 7px 12px; font-size: 13px; font-weight: 700;
}
QPushButton#btnRecharge:disabled { background: #EEF1F5; color: #9AA3B0; }
QPushButton#btnLogout {
    background: #FFFFFF; color: #D14343; border: 1px solid #F0C7C7;
    border-radius: 10px; font-weight: 700;
}
QLabel#accountStatusLabel {
    color: #9A6700; background: #FFF7D6;
    border: 1px solid #F1D179; border-radius: 8px; padding: 8px;
}
QListWidget#profileMenuList {
    background: #FFFFFF; border: 1px solid #E7ECF2; border-radius: 12px;
    outline: none; padding: 4px 12px;
}
QListWidget#profileMenuList::item {
    min-height: 56px; padding: 2px 8px; color: #202B3C;
    border-bottom: 1px solid #EDF1F5; font-size: 14px;
}
QListWidget#profileMenuList::item:hover { background: #F7FAFF; color: #1677FF; }
QPushButton#stationRow {
    background: #FFFFFF; border: none; border-bottom: 1px solid #EDF1F5;
    padding: 0; color: #202B3C;
}
QFrame#mapStatePanel, QFrame#locationStatePanel {
    background: rgba(255, 255, 255, 238); border: 1px solid #DCE5F0;
    border-radius: 11px;
}
QFrame#mapStatePanel[state="error"], QFrame#locationStatePanel[state="error"] {
    background: rgba(255, 247, 247, 242); border-color: #F0CACA;
}
QLabel#mapStateLabel, QLabel#locationStateLabel {
    background: transparent; border: none; color: #596579; font-size: 11px;
}
QFrame#mapStatePanel[state="error"] QLabel#mapStateLabel,
QFrame#locationStatePanel[state="error"] QLabel#locationStateLabel { color: #C93636; }
QPushButton#mapRetryButton, QPushButton#locationRetryButton,
QPushButton#stationRetryButton {
    background: #EAF3FF; color: #1677FF; border: 1px solid #A9CBFF;
    border-radius: 8px; padding: 0 8px; font-size: 10px; font-weight: 700;
}
QFrame#stationStateBar {
    background: #F3F7FC; border: none; border-bottom: 1px solid #E1E8F0;
}
QFrame#stationStateBar[state="empty"] { background: #F7F9FC; }
QFrame#stationStateBar[state="error"] { background: #FFF4F4; border-bottom-color: #F2CACA; }
QLabel#stationStateLabel { background: transparent; color: #687386; font-size: 11px; }
QFrame#stationStateBar[state="error"] QLabel#stationStateLabel { color: #C93636; }
QLabel#stationCountLabel { color: #8A94A3; font-size: 10px; }
QComboBox#stationSortCombo {
    background: #FFFFFF; color: #4E596A; border: 1px solid #DCE5F0;
    border-radius: 8px; padding: 3px 7px; font-size: 10px;
}
QComboBox#stationSortCombo:hover { border-color: #8BB9FF; color: #1677FF; }
QComboBox#stationSortCombo::drop-down { border: none; width: 18px; }
QPushButton#stationRow[selected="true"] {
    background: #F7FAFF; border: 2px solid #2878FF; border-radius: 11px;
    padding: 0;
}
QLabel#stationRowIcon { background: transparent; border: none; }
QLabel#stationRowName {
    background: transparent; color: #202B3C; border: none;
    font-size: 12px; font-weight: 700;
}
QLabel#stationRowAddress, QLabel#stationRowDistance {
    background: transparent; color: #7D8898; border: none; font-size: 10px;
}
QLabel#stationRowMeta {
    background: transparent; color: #1677FF; border: none;
    font-size: 10px; font-weight: 600;
}
QPushButton#stationDetailsButton {
    background: #EAF3FF; color: #1677FF; border: 1px solid #A9CBFF;
    border-radius: 14px; padding: 0; font-size: 10px; font-weight: 700;
}
QPushButton#stationDetailsButton:hover {
    background: #1677FF; color: #FFFFFF; border-color: #1677FF;
}
QToolButton#homeNav, QToolButton#chargeNav, QToolButton#profileNav {
    background: transparent; border: none; color: #8A94A3;
    font-size: 11px; padding: 3px 16px;
}
QToolButton#homeNav:checked, QToolButton#chargeNav:checked, QToolButton#profileNav:checked { color: #1677FF; font-weight: 700; }
QPushButton#driveButton, QPushButton#walkButton {
    background: transparent; border: none; border-radius: 7px;
    color: #7D8898; font-size: 11px;
}
QPushButton#driveButton:checked, QPushButton#walkButton:checked { background: #EAF3FF; color: #1677FF; font-weight: 700; }
QFrame#routeCard { background: #FFFFFF; border-top: 1px solid #E6EBF1; }
QLabel#routeInfo { color: #7E8998; font-size: 11px; }
QLabel#hintLabel2 { color: #8B96A6; font-size: 10px; }
QFrame.metricCard { background: #F8FAFD; border: none; border-radius: 9px; }
QLabel.metricValue { font-size: 18px; font-weight: 700; }
QLabel.metricCaption { color: #8C97A6; font-size: 9px; }
QFrame.chargerRow, QFrame#chargerRow { background: #FFFFFF; border-bottom: 1px solid #EDF1F5; }
QLabel.chargerName, QLabel#chargerName { font-size: 12px; font-weight: 700; }
QLabel.chargerSpec, QLabel#chargerSpec { color: #8B96A6; font-size: 9px; }
QLabel.availableBadge, QLabel#availableBadge { color: #13966B; background: #E8F8F1; border-radius: 8px; padding: 3px 7px; }
QLabel.busyBadge, QLabel#busyBadge { color: #8993A2; background: #F0F2F5; border-radius: 8px; padding: 3px 7px; }
QLabel#chargerIdLabel {
    color: #12AFA5; background: #F0FFFD; border: 1px solid #9EE7E1;
    border-radius: 9px; padding: 9px 5px; font-size: 15px; font-weight: 700;
}
QFrame#chargerRow[available="false"] QLabel#chargerIdLabel {
    color: #8A94A3; background: #F5F6F8; border-color: #DDE2E8;
}
QLabel#availabilityLabel { color: #12AFA5; font-size: 13px; font-weight: 700; }
QScrollArea#detailScroll, QScrollArea#detailScroll > QWidget > QWidget {
    background: #F6F8FC; border: none;
}
QFrame#summaryCard { background: #FFFFFF; border-color: #E2E8F0; }
QLabel#stationName { color: #17243A; font-size: 19px; font-weight: 800; }
QLabel#addressLabel { color: #748196; font-size: 11px; }
QLabel#addressIcon { background: transparent; }
QFrame#availabilityCard {
    background: #F8FAFD; border: 1px solid #E8EDF4; border-radius: 10px;
}
QWidget#availableMetric, QWidget#unavailableMetric, QWidget#totalMetric,
QLabel#availableCountValue, QLabel#unavailableCountValue,
QLabel#totalCountValue, QLabel#availableCountCaption,
QLabel#unavailableCountCaption, QLabel#totalCountCaption { background: transparent; }
QLabel#availableCountValue { color: #10AFA4; font-size: 20px; font-weight: 800; }
QLabel#unavailableCountValue { color: #F28A20; font-size: 20px; font-weight: 800; }
QLabel#totalCountValue { color: #526174; font-size: 20px; font-weight: 800; }
QLabel#availableCountCaption, QLabel#unavailableCountCaption,
QLabel#totalCountCaption { color: #8490A1; font-size: 9px; }
QFrame#metricDivider1, QFrame#metricDivider2 { color: #E1E7EF; }
QFrame#feeCard { background: #FFFFFF; border-color: #E2E8F0; }
QLabel#feeIcon, QLabel#feeTitleLabel, QLabel#priceLabel { background: transparent; }
QLabel#feeTitleLabel { color: #263449; font-size: 13px; font-weight: 600; }
QLabel#priceLabel { color: #1677FF; font-size: 18px; font-weight: 800; }
QFrame#chargerListCard {
    background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 13px;
}
QFrame#chargerListCard > QLabel#sectionTitle {
    background: transparent; padding-left: 14px; font-size: 14px; font-weight: 700;
}
QWidget#chargerListHost { background: transparent; }
QFrame#chargerRow { border-bottom-color: #E8EDF3; }
QLabel#chargerActionIcon { background: #F4FBFA; border: 1px solid #B8E9E4; border-radius: 16px; }
QFrame#chargerRow[available="false"] QLabel#chargerActionIcon {
    background: #F4F6F8; border-color: #DFE4EA;
}
QWidget#footer { background: #FFFFFF; border-top: 1px solid #E4E9F0; }
QPushButton#navigationButton { border: 1px solid #1677FF; background: #FFFFFF; }
QPushButton#chargeButton:disabled {
    background: #AFCBF4; color: #F7FAFF;
}
QLabel#detailStateLabel[state="loading"], QLabel#routeStateLabel[state="loading"] {
    color: #687386; background: #F3F7FC; border-radius: 8px; padding: 7px;
}
QLabel#detailStateLabel[state="error"], QLabel#routeStateLabel[state="error"] {
    color: #C93636; background: #FFF2F2; border: 1px solid #F2CACA;
    border-radius: 8px; padding: 7px;
}
QLabel#detailStateLabel[state="neutral"], QLabel#routeStateLabel[state="neutral"] {
    color: #687386; background: #F6F8FC; border-radius: 8px; padding: 7px;
}
QPushButton#detailRetryButton, QPushButton#routeRetryButton,
QPushButton#manualOriginButton, QPushButton#modifyOriginButton {
    background: #EAF3FF; color: #1677FF; border: 1px solid #A9CBFF;
    border-radius: 8px; font-weight: 700;
}
QFrame#endpointCard {
    background: #FFFFFF; border: 1px solid #E7ECF2; border-radius: 11px;
    margin: 8px 12px 6px 12px;
}
QLabel#originLabel { color: #13AFA5; font-size: 13px; font-weight: 600; }
QLabel#destinationLabel { color: #E5485D; font-size: 13px; font-weight: 600; }
QLineEdit#manualOriginEdit {
    background: #F7F9FC; border: 1px solid #DCE3EC; border-radius: 8px;
    padding: 6px 9px; color: #202B3C;
}
QPushButton#originCandidateButton {
    background: #F7FAFF; color: #334155; border: 1px solid #DCE8FA;
    border-radius: 7px; padding: 5px 8px; text-align: left;
}
QPushButton#originCandidateButton:hover { border-color: #73AAFF; color: #1677FF; }
QFrame#originEditorPanel {
    background: #FFFFFF; border: 1px solid #DCE5F0; border-radius: 14px;
}
QLabel#originEditorTitle {
    color: #17243A; background: transparent; font-size: 15px; font-weight: 700;
}
QPushButton#originEditorBackButton {
    background: transparent; color: #17243A; border: none;
    font-size: 24px; font-weight: 500;
}
QLabel#relatedPlacesTitle {
    color: #536174; background: transparent; font-size: 12px; font-weight: 700;
}
QLabel#originCandidatesEmptyLabel {
    color: #8994A3; background: #F7F9FC; border-radius: 8px; padding: 12px;
}
QScrollArea#originCandidatesScroll, QWidget#originCandidatesHost {
    background: transparent; border: none;
}
QFrame#routeStepRow {
    background: #F8FAFD; border: 1px solid #E8EDF4; border-radius: 9px;
}
QLabel#routeStepNumber {
    color: #FFFFFF; background: #1677FF; border-radius: 13px;
    font-size: 11px; font-weight: 700;
}
QFrame#routeStepRow[endpoint="start"] QLabel#routeStepNumber { background: #18B8AC; }
QFrame#routeStepRow[endpoint="end"] QLabel#routeStepNumber { background: #F0445E; }
QLabel#routeStepInstruction {
    color: #334155; background: transparent; font-size: 11px; font-weight: 600;
}
QLabel#routeStepDistance {
    color: #8490A1; background: transparent; font-size: 10px;
}
RoutePreviewWidget#routeMap { background: #EEF4F8; border: none; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 3px; background: transparent; }
QScrollBar::handle:vertical { background: #CFD7E2; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QCheckBox { color: #8994A3; font-size: 10px; spacing: 6px; }


/* Station detail and route preview layout */
QWidget#navigationBackground { background: #F6F8FC; }
QFrame#endpointCard, QFrame#modeCard, QFrame#routeCard {
    background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 13px; margin: 0;
}
QLabel#originDot { color: #18B8AC; font-size: 17px; background: transparent; }
QLabel#destinationDot { color: #F0445E; font-size: 17px; background: transparent; }
QLabel#originLabel, QLabel#destinationLabel {
    color: #17243A; background: transparent; font-size: 13px; font-weight: 600;
}
QFrame#endpointDivider { color: #E8EDF3; }
QPushButton#driveButton, QPushButton#walkButton {
    min-height: 36px; background: transparent; border: none; border-radius: 9px;
    color: #778397; font-size: 13px; font-weight: 600;
}
QPushButton#driveButton:checked, QPushButton#walkButton:checked {
    background: #EAF3FF; color: #1677FF; border-bottom: 2px solid #1677FF;
}
QFrame#mapArea { background: #EEF4F8; border: 1px solid #DEE6EF; border-radius: 13px; }
QWidget#distanceMetric, QWidget#durationMetric,
QLabel#routeInfo, QLabel#routeTime, QLabel#distanceCaption, QLabel#durationCaption {
    background: transparent;
}
QLabel#routeInfo, QLabel#routeTime { color: #17243A; font-size: 22px; font-weight: 800; }
QLabel#distanceCaption, QLabel#durationCaption { color: #8490A1; font-size: 10px; }
QFrame#routeMetricDivider { color: #E1E7EF; }
QPushButton#startButton {
    background: #1677FF; color: #FFFFFF; border: none; border-radius: 10px;
    font-size: 14px; font-weight: 700;
}
QPushButton#startButton:hover { background: #0D6BE8; }
