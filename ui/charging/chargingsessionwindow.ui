  <property name="styleSheet"><string notr="true">#ChargingSessionWindow { background: #F8FAFE; color: #0A1835; }
#ChargingSessionWindow QLabel, #progressContainer { background: transparent; }
#chargingSessionTitle { font-size: 25px; font-weight: 700; background: transparent; }
#chargingStateInRingLabel { color: #0874F9; font-size: 28px; font-weight: 700; background: transparent; }
#currentPowerLabel { color: #071630; font-size: 38px; font-weight: 700; background: transparent; }
#energyCaption, #durationCaption, #amountCaption { color: #758097; font-size: 14px; background: transparent; }
#energyValueLabel, #durationValueLabel, #amountValueLabel { color: #0A1835; font-size: 21px; font-weight: 600; background: transparent; }
#sessionStateLabel { background: #FFF7E7; color: #A86600; border-radius: 8px; padding: 8px; }
#sessionRefreshButton { border: none; color: #0874F9; background: transparent; }
#scanChargingButton { background: #0874F9; border: none; border-radius: 14px; color: white; font-size: 17px; font-weight: 700; }
#stopChargingButton { background: transparent; border: 2px solid #0874F9; border-radius: 14px; color: #0874F9; font-size: 18px; font-weight: 700; }
#stopChargingButton:disabled { border-color: #CAD5E5; color: #9AA7BA; }</string></property>
