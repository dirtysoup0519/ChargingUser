 <class>ChargingSessionWindow</class>
 <widget class="QWidget" name="ChargingSessionWindow">
  <property name="minimumSize"><size><width>390</width><height>680</height></size></property>
  <property name="styleSheet"><string notr="true">#ChargingSessionWindow { background: #F8FAFE; color: #0A1835; }
#ChargingSessionWindow QLabel, #progressContainer, #sessionCard { background: transparent; }
#chargingSessionTitle { font-size: 25px; font-weight: 700; background: transparent; }
#chargingStateInRingLabel { color: #0874F9; font-size: 28px; font-weight: 700; background: transparent; }
#currentPowerLabel { color: #071630; font-size: 38px; font-weight: 700; background: transparent; }
#energyCaption, #durationCaption, #amountCaption { color: #758097; font-size: 14px; background: transparent; }
#energyValueLabel, #durationValueLabel, #amountValueLabel { color: #0A1835; font-size: 21px; font-weight: 600; background: transparent; }
#sessionSelectorButton { background: #F8FAFE; border: 1px solid #D5E1F2; border-radius: 16px; padding: 14px 40px 14px 16px; color: #13223F; font-size: 14px; font-weight: 600; }
#sessionSelectorButton::drop-down { width: 36px; border: none; }
#sessionSelectorButton QAbstractItemView { background: white; color: #13223F; border: 1px solid #D9E5F6; selection-background-color: #EAF3FF; selection-color: #0874F9; outline: 0; padding: 5px; }
#selectedStationLabel { color: #13223F; font-size: 14px; font-weight: 700; }
#selectedChargerLabel { color: #62718A; font-size: 12px; }
#sessionSwitchHintLabel { color: #7B879B; font-size: 12px; padding-left: 4px; }
#sessionStateLabel { background: #FFF7E7; color: #A86600; border-radius: 8px; padding: 8px; }
#sessionRefreshButton { border: none; color: #0874F9; background: transparent; }
#scanChargingButton { background: #0874F9; border: none; border-radius: 14px; color: white; font-size: 17px; font-weight: 700; }
#stopChargingButton { background: transparent; border: 2px solid #0874F9; border-radius: 14px; color: #0874F9; font-size: 18px; font-weight: 700; }
#stopChargingButton:disabled { border-color: #CAD5E5; color: #9AA7BA; }</string></property>
  <layout class="QVBoxLayout" name="rootLayout"><property name="leftMargin"><number>16</number></property><property name="topMargin"><number>16</number></property><property name="rightMargin"><number>16</number></property><property name="bottomMargin"><number>16</number></property><property name="spacing"><number>10</number></property>
